{
  "components": {
    "schemas": {
      "AcceptedDocumentResponse": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parser": {
            "$ref": "#/components/schemas/ParserKind"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          }
        },
        "required": ["id", "filename", "parser", "status", "created_at"],
        "title": "AcceptedDocumentResponse",
        "type": "object"
      },
      "BatchAcceptedResponse": {
        "additionalProperties": false,
        "description": "One accepted asynchronous document per uploaded file.",
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/AcceptedDocumentResponse"
            },
            "title": "Documents",
            "type": "array"
          }
        },
        "required": ["documents"],
        "title": "BatchAcceptedResponse",
        "type": "object"
      },
      "Body_submit_documents_api_v1_documents_post": {
        "properties": {
          "files": {
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          },
          "parser": {
            "$ref": "#/components/schemas/ParserKind"
          }
        },
        "required": ["parser", "files"],
        "title": "Body_submit_documents_api_v1_documents_post",
        "type": "object"
      },
      "CompletedDocumentResponse": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "completed_at": {
            "format": "date-time",
            "title": "Completed At",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageResponse"
            },
            "title": "Pages",
            "type": "array"
          },
          "parser": {
            "$ref": "#/components/schemas/ParserKind"
          },
          "status": {
            "const": "completed",
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "parser",
          "created_at",
          "updated_at",
          "attempts",
          "status",
          "pages",
          "summary",
          "completed_at"
        ],
        "title": "CompletedDocumentResponse",
        "type": "object"
      },
      "DocumentResponse": {
        "discriminator": {
          "mapping": {
            "completed": "#/components/schemas/CompletedDocumentResponse",
            "failed": "#/components/schemas/FailedDocumentResponse",
            "processing": "#/components/schemas/ProcessingDocumentResponse",
            "queued": "#/components/schemas/QueuedDocumentResponse"
          },
          "propertyName": "status"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/QueuedDocumentResponse"
          },
          {
            "$ref": "#/components/schemas/ProcessingDocumentResponse"
          },
          {
            "$ref": "#/components/schemas/CompletedDocumentResponse"
          },
          {
            "$ref": "#/components/schemas/FailedDocumentResponse"
          }
        ]
      },
      "DocumentStatus": {
        "enum": ["queued", "processing", "completed", "failed"],
        "title": "DocumentStatus",
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "Stable, user-safe error information.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": ["error"],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FailedDocumentResponse": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "completed_at": {
            "format": "date-time",
            "title": "Completed At",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parser": {
            "$ref": "#/components/schemas/ParserKind"
          },
          "status": {
            "const": "failed",
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "parser",
          "created_at",
          "updated_at",
          "attempts",
          "status",
          "error",
          "completed_at"
        ],
        "title": "FailedDocumentResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "LivenessResponse",
        "type": "object"
      },
      "PageResponse": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "markdown": {
            "title": "Markdown",
            "type": "string"
          }
        },
        "required": ["index", "markdown"],
        "title": "PageResponse",
        "type": "object"
      },
      "ParserKind": {
        "enum": ["pypdf", "gemini"],
        "title": "ParserKind",
        "type": "string"
      },
      "ProcessingDocumentResponse": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parser": {
            "$ref": "#/components/schemas/ParserKind"
          },
          "status": {
            "const": "processing",
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "filename", "parser", "created_at", "updated_at", "attempts", "status"],
        "title": "ProcessingDocumentResponse",
        "type": "object"
      },
      "QueuedDocumentResponse": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parser": {
            "$ref": "#/components/schemas/ParserKind"
          },
          "status": {
            "const": "queued",
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "filename", "parser", "created_at", "updated_at", "attempts", "status"],
        "title": "QueuedDocumentResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": ["ok", "unhealthy"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status", "checks"],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Upload PDFs for asynchronous extraction and summarization.",
    "title": "Async document processor",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/documents": {
      "post": {
        "operationId": "submit_documents_api_v1_documents_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_submit_documents_api_v1_documents_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchAcceptedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Submit Documents"
      }
    },
    "/api/v1/documents/{document_id}": {
      "get": {
        "operationId": "get_document_api_v1_documents__document_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Document"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness"
      }
    }
  }
}
