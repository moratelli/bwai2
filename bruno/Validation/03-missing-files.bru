meta {
  name: Reject missing files
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  parser: pypdf
}

tests {
  test("Returns 422 invalid_request", () => {
    expect(res.getStatus()).to.equal(422);
    const error = res.getBody().error;
    expect(error.code).to.equal("invalid_request");
    expect(typeof error.message).to.equal("string");
    expect(error.message.length > 0).to.equal(true);
  });
}
