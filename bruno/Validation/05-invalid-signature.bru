meta {
  name: Reject non-PDF content
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  parser: pypdf
  files: @file(./fixtures/not-pdf.pdf) @contentType(application/pdf)
}

tests {
  test("Returns 422 invalid_pdf", () => {
    expect(res.getStatus()).to.equal(422);
    const error = res.getBody().error;
    expect(error.code).to.equal("invalid_pdf");
    expect(typeof error.message).to.equal("string");
    expect(error.message.length > 0).to.equal(true);
  });
}
