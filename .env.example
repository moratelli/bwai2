# Browser URL: http://localhost:${APP_PORT}
APP_PORT=8080

# Gemini is required because every normal successful document is summarized with Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Mistral is optional. It is needed only for Scanned document / OCR mode.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

REDIS_URL=redis://redis:6379/0
DOCUMENT_TTL_SECONDS=86400
MAX_FILES_PER_BATCH=10
MAX_FILE_SIZE_BYTES=20971520
SUMMARY_CHUNK_CHARACTERS=100000
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=3

# CI/container smoke tests only. Keep false for normal use.
TEST_SUMMARIZER_ENABLED=false
